<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stats_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="12dp"
    android:gravity="center">

    <FrameLayout
        android:id="@+id/stats_widget_icon_bg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="#EF4444">

        <ImageView
            android:id="@+id/stats_widget_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic_white"
            android:contentDescription="Grabar" />
    </FrameLayout>

    <TextView
        android:id="@+id/stats_widget_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="00:00"
        android:textColor="#F1F5F9"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/stats_widget_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0 KB"
        android:textColor="#94A3B8"
        android:textSize="13sp" />

</LinearLayout>
